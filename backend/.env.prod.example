# ── backend/.env.prod ──────────────────────────────────────────────────────────
# Copia este archivo: cp backend/.env.prod.example backend/.env.prod
# Luego rellena tus claves reales
# DATABASE_URL se inyecta automáticamente por docker-compose.prod.yml
# ─────────────────────────────────────────────────────────────────────────────

# Clave API de Google Gemini (IA para análisis)
GEMINI_API_KEY=PON_TU_GEMINI_KEY_AQUI

# Clave secreta para JWT (puedes poner cualquier string largo y aleatorio)
SECRET_KEY=cambia-esto-por-un-string-muy-largo-y-aleatorio-2025

# Nombre del proyecto (opcional, solo para logs)
PROJECT_NAME=Evaluacion Docente IA - PUCESE

# En producción detrás de Apache: Apache maneja CORS, no FastAPI (evita header duplicado)
DISABLE_CORS=true
